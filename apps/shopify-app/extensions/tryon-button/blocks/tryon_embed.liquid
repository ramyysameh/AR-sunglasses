{% comment %}
  AR Try-on app embed. Switched on once for the whole store (the admin's "Turn
  on try-on" deep link opens the theme editor with it active), it adds the
  Try-on button to every product page whose product has a model -- no placing
  blocks in templates. Same markup and script as the app block (snippet
  tryon_core); if a page also has the block, the block (earlier in the DOM)
  wins the first-instance dedupe and this copy removes itself.

  The embed is also the on/off switch for blocks: a block's button is hidden by
  tryon_core's styles until this rule reveals it, so turning the embed off hides
  every Try-on button in the store. Output on every page (no enabled_on), since
  a block can sit in a featured-product section outside product templates.
{% endcomment %}
<style>
  html .ar-tryon[data-ar-tryon-placement="block"]:not([data-ar-tryon-design-mode]) {
    display: block;
  }
  html .ar-tryon[data-ar-tryon-placement="block"][data-ar-tryon-design-mode] .ar-tryon__open {
    display: inline-flex;
  }
  html .ar-tryon__embed-off {
    display: none;
  }
</style>
{% if request.page_type == 'product' and product %}
  {% assign dialog_id = 'ar-tryon-dialog-embed-' | append: product.id %}
  {% render 'tryon_core',
    product: product,
    engine_url: block.settings.engine_url,
    model_url: '',
    gscale: block.settings.gscale,
    button_label: block.settings.button_label,
    dialog_id: dialog_id,
    attributes: block.shopify_attributes,
    placement: 'embed'
  %}
  <script>
    (() => {
      // Runs after tryon_core's own script (dedupe + ping). If the block won,
      // there is no embed root left and nothing to place.
      const root = document.querySelector('.ar-tryon[data-ar-tryon-placement="embed"]')
      if (!root) return

      // Themes name their product area differently; look in <main> or any
      // role="main" region for the Add to cart submit.
      const scopes = ['main', '[role="main"]']
      const submitSelector = scopes
        .flatMap((scope) => [
          `${scope} form[action*="/cart/add"] [type="submit"]`,
          `${scope} form[action*="/cart/add"] button[name="add"]`,
          `${scope} button[form][type="submit"]`,
          `${scope} button[form][name="add"]`,
        ])
        .join(', ')

      // Shopify's dynamic checkout ("Buy it now") button. Its wrapper is in the
      // theme's server markup (the form's payment_button filter), so it is in
      // the DOM even though the button inside it renders later.
      const paymentSelector = '.shopify-payment-button, [data-shopify="payment-button"]'

      // The Buy now button that belongs to the same product as this Add to cart:
      // look in its form, then a few ancestors up, so a featured-product section
      // or quick-add card elsewhere in <main> can't capture the button.
      function findPaymentButton(submit) {
        const form = submit.form || submit.closest('form')
        const inForm = form && form.querySelector(paymentSelector)
        if (inForm) return inForm
        let node = submit.parentElement
        for (let depth = 0; node && depth < 3; depth++, node = node.parentElement) {
          const match = node.querySelector(paymentSelector)
          if (match) return match
        }
        return null
      }

      // In the theme editor the page is re-rendered constantly and the root must
      // stay where Shopify put it, so float it instead of moving it into a form.
      const inEditor = Boolean(root.dataset && root.dataset.arTryonDesignMode)

      // This runs on a live storefront inside a theme we don't control: a
      // failed placement must never surface as a page error, so it is swallowed
      // and the button simply stays wherever it already is.
      function place() {
        try {
          const submit = inEditor ? null : document.querySelector(submitSelector)
          if (submit) {
            root.classList.remove('ar-tryon--floating')
            // Below Buy now when the theme shows one, otherwise below Add to cart.
            const target = findPaymentButton(submit) || submit
            // In a flex row the full-width button would squeeze in beside the
            // buttons; go after the row instead so it gets its own line.
            const parent = target.parentElement
            const parentDisplay =
              parent && typeof getComputedStyle === 'function' ? getComputedStyle(parent).display : ''
            const anchor = /flex/.test(parentDisplay) ? parent : target
            anchor.insertAdjacentElement('afterend', root)
          } else {
            root.classList.add('ar-tryon--floating')
            // A theme that swaps out <main> can take a floating root with it.
            if (!root.isConnected && document.body) document.body.appendChild(root)
          }
        } catch (error) {
          // intentionally silent
        }
      }

      place()
      if (inEditor || typeof MutationObserver === 'undefined') return

      // Themes re-render the product form (variant change) or replace <main>
      // wholesale, which destroys the moved root. Put it back when that happens.
      let pending = false
      const recheck = () => {
        pending = false
        if (!root.isConnected) place()
      }
      new MutationObserver(() => {
        if (pending || root.isConnected) return
        pending = true
        if (typeof requestAnimationFrame === 'function') requestAnimationFrame(recheck)
        else recheck()
      }).observe(document.body, { childList: true, subtree: true })
    })()
  </script>
{% endif %}

{% schema %}
{
  "name": "AR Try-on",
  "target": "body",
  "settings": [
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Try on" },
    { "type": "range", "id": "gscale", "label": "Glasses size", "min": 0.5, "max": 2.5, "step": 0.1, "unit": "x", "default": 1, "info": "Scales the glasses on the face. 1 = natural fit; higher = larger. Try ~1.6 if they look too small." },
    { "type": "text", "id": "engine_url", "label": "Try-on engine URL", "default": "https://ar-sunglasses-tryon.vercel.app/tryon/index.html", "info": "Pre-filled with the hosted try-on engine -- only change this if you're running your own instance (e.g. a local dev URL)." }
  ]
}
{% endschema %}
