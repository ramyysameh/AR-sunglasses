{% comment %}
  AR Try-On app block. Adds a "Try on" button to the product page that opens the
  hosted MediaPipe + Three.js try-on engine in a camera-permitted iframe. The engine
  reads ?shop= and ?productId= and fetches its calibrated config from the app.
{% endcomment %}

{% comment %}
  A theme block lives in a TEMPLATE, not on a product, so adding it once puts it
  on every product sharing that template -- including ones with no model. The app
  writes this app-owned metafield whenever a product is mapped in the admin (and
  deletes it on unmap), so it is the storefront's gate: no mapping, no output.

  Deliberately renders NOTHING (not an empty container) when unmapped, except in
  the theme editor, where silence would read as a broken app.
{% endcomment %}
{% assign tryon_enabled = block.settings.product.metafields["$app:tryon"].enabled.value %}

{% comment %}
  Ties each button to its own dialog for the declarative commandfor/command
  attributes. Section + block id, so the same block rendered twice on one
  page (a quick-view drawer beside the main product) still gets distinct ids.
{% endcomment %}
{% assign dialog_id = 'ar-tryon-dialog-' | append: section.id | append: '-' | append: block.id %}

{% if tryon_enabled %}
  {% render 'tryon_core',
    product: block.settings.product,
    engine_url: block.settings.engine_url,
    model_url: block.settings.model_url,
    gscale: block.settings.gscale,
    button_label: block.settings.button_label,
    dialog_id: dialog_id,
    attributes: block.shopify_attributes,
    placement: 'block'
  %}
{% elsif request.design_mode %}
  <div class="ar-tryon__unmapped" {{ block.shopify_attributes }}>
    <p>
      <strong>AR Try-On</strong> — no model is mapped to this product yet, so the button
      stays hidden on your storefront. Map a model to it in the AR Try-on app, then reload
      the theme editor.
    </p>
  </div>
  <style>
    .ar-tryon__unmapped {
      padding: 1rem;
      border: 1px dashed #8a8a8a;
      border-radius: 4px;
      color: #616161;
      font: inherit;
    }
    .ar-tryon__unmapped p {
      margin: 0;
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "AR Try-On",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    { "type": "text", "id": "engine_url", "label": "Try-on engine URL", "default": "https://ar-sunglasses-tryon.vercel.app/tryon/index.html", "info": "Pre-filled with the hosted try-on engine -- only change this if you're running your own instance (e.g. a local dev URL)." },
    { "type": "text", "id": "model_url", "label": "Model (GLB) URL", "info": "Optional override for a product that is already mapped in the app: upload the .glb under Settings → Files and paste its URL here. Leave blank to use the mapped model. This does not turn try-on on — a product with no model mapped in the app stays hidden either way." },
    { "type": "range", "id": "gscale", "label": "Glasses size", "min": 0.5, "max": 2.5, "step": 0.1, "unit": "x", "default": 1, "info": "Scales the glasses on the face. 1 = natural fit; higher = larger. Try ~1.6 if they look too small." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Try on" }
  ]
}
{% endschema %}
